#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(binding = 0, rgba8) uniform readonly image2D currentFrame;
layout(binding = 1, rgba8) uniform readonly image2D warpedPreviousFrame;
layout(binding = 2, r8) uniform readonly image2D occlusionMask;
layout(binding = 3, rgba8) uniform writeonly image2D outputFrame;

// Vulkan shader blending current frame with warped previous frame based on occlusion confidence
void main() {
    ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(currentFrame);

    if (pos.x >= size.x || pos.y >= size.y) {
        return;
    }

    vec4 curr = imageLoad(currentFrame, pos);
    vec4 prev = imageLoad(warpedPreviousFrame, pos);
    float confidence = imageLoad(occlusionMask, pos).r; // 0.0 to 1.0

    // Blend: if confident, blend 70% current + 30% warped previous; if occluded, fallback to 100% current
    float blendFactor = 0.3 * confidence;
    vec4 result = mix(curr, prev, blendFactor);

    imageStore(outputFrame, pos, result);
}
